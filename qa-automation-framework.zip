FILES["tests/test_login.py"] = r'''
import allure
import pytest

from pages.inventory_page import InventoryPage
from pages.login_page import LoginPage
from utils.data_reader import read_csv

NEGATIVE_CASES = read_csv("login_negative.csv")


@allure.feature("Login")
class TestLogin:
    @pytest.mark.smoke
    def test_valid_login(self, driver, config):
        LoginPage(driver, config["timeout"]).open(config["base_url"]).login(
            config["username"], config["password"]
        )
        assert InventoryPage(driver, config["timeout"]).title() == "Products"
        assert "/inventory.html" in driver.current_url

    @pytest.mark.regression
    @pytest.mark.parametrize("case", NEGATIVE_CASES, ids=[c["case"] for c in NEGATIVE_CASES])
    def test_invalid_login(self, driver, config, case):
        page = LoginPage(driver, config["timeout"]).open(config["base_url"])
        page.login(case["username"], case["password"])
        assert case["expected_error"] in page.error_message()

    @pytest.mark.regression
    def test_logout_returns_to_login(self, driver, config, inventory_page):
        inventory_page.logout()
        assert LoginPage(driver, config["timeout"]).is_loaded()
'''

FILES["tests/test_inventory.py"] = r'''
import allure
import pytest


@allure.feature("Inventory")
class TestInventory:
    @pytest.mark.smoke
    def test_inventory_shows_six_products(self, inventory_page):
        assert inventory_page.item_count() == 6

    @pytest.mark.regression
    @pytest.mark.parametrize(
        "option, getter, reverse",
        [
            ("az", "names", False),
            ("za", "names", True),
            ("lohi", "prices", False),
            ("hilo", "prices", True),
        ],
        ids=["name-a-z", "name-z-a", "price-low-high", "price-high-low"],
    )
    def test_sorting(self, inventory_page, option, getter, reverse):
        inventory_page.sort_by(option)
        values = getattr(inventory_page, getter)()
        assert values == sorted(values, reverse=reverse)

    @pytest.mark.regression
    @pytest.mark.parametrize("n", [1, 3, 6])
    def test_cart_badge_matches_items_added(self, inventory_page, n):
        assert inventory_page.cart_count() == 0
        inventory_page.add_first_n_items(n)
        assert inventory_page.cart_count() == n

    @pytest.mark.regression
    def test_removing_item_updates_badge(self, inventory_page):
        inventory_page.add_first_n_items(2)
        inventory_page.remove_first_item()
        assert inventory_page.cart_count() == 1
'''

FILES["tests/test_checkout.py"] = r'''
import allure
import pytest

from pages.cart_page import CartPage
from pages.checkout_page import CheckoutPage
from utils.data_reader import read_json

DATA = read_json("checkout.json")
INVALID_CUSTOMERS = DATA["invalid_customers"]


def go_to_checkout(driver, config, inventory_page, items=1):
    """Shared setup: add items, open cart, click checkout."""
    inventory_page.add_first_n_items(items)
    inventory_page.open_cart()
    cart = CartPage(driver, config["timeout"])
    assert cart.item_count() == items
    cart.checkout()
    return CheckoutPage(driver, config["timeout"])


@allure.feature("Checkout")
class TestCheckout:
    @pytest.mark.smoke
    def test_complete_purchase(self, driver, config, inventory_page):
        expected_total = round(sum(inventory_page.prices()[:2]), 2)
        checkout = go_to_checkout(driver, config, inventory_page, items=2)

        customer = DATA["valid_customer"]
        checkout.fill_info(customer["first_name"], customer["last_name"], customer["postal_code"])

        assert checkout.item_total() == expected_total
        checkout.finish()
        assert checkout.confirmation() == "Thank you for your order!"

    @pytest.mark.regression
    @pytest.mark.parametrize(
        "customer", INVALID_CUSTOMERS, ids=[c["case"] for c in INVALID_CUSTOMERS]
    )
    def test_checkout_validation(self, driver, config, inventory_page, customer):
        checkout = go_to_checkout(driver, config, inventory_page)
        checkout.fill_info(customer["first_name"], customer["last_name"], customer["postal_code"])
        assert customer["error"] in checkout.error_message()
'''

