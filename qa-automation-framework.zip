FILES["conftest.py"] = r'''
import re
from pathlib import Path

import allure
import pytest

from pages.inventory_page import InventoryPage
from pages.login_page import LoginPage
from utils.config_loader import load_config
from utils.driver_factory import create_driver
from utils.logger import get_logger

log = get_logger("conftest")
SCREENSHOT_DIR = Path("screenshots")


def pytest_addoption(parser):
    parser.addoption("--env", default="qa", help="Environment from config/environments.json")
    parser.addoption("--browser", default="chrome", choices=["chrome", "firefox", "edge"])
    parser.addoption("--headless", action="store_true", default=False, help="Run without a UI")


@pytest.hookimpl(tryfirst=True, hookwrapper=True)
def pytest_runtest_makereport(item, call):
    """Stores each phase's result on the test item so fixtures can see if it failed."""
    outcome = yield
    report = outcome.get_result()
    setattr(item, f"rep_{report.when}", report)


@pytest.fixture(scope="session")
def config(request):
    cfg = load_config(request.config.getoption("--env"))
    log.info("Running against env '%s' (%s)", cfg["env"], cfg["base_url"])
    return cfg


@pytest.fixture(autouse=True)
def log_test_boundaries(request):
    log.info("START %s", request.node.nodeid)
    yield
    log.info("END   %s", request.node.nodeid)


@pytest.fixture
def driver(request, config):
    browser = request.config.getoption("--browser")
    headless = request.config.getoption("--headless")
    drv = create_driver(browser, headless)

    yield drv

    call_report = getattr(request.node, "rep_call", None)
    if call_report is not None and call_report.failed:
        SCREENSHOT_DIR.mkdir(exist_ok=True)
        safe_name = re.sub(r"[^\w.\-]", "_", request.node.name)
        png = drv.get_screenshot_as_png()
        (SCREENSHOT_DIR / f"{safe_name}.png").write_bytes(png)
        allure.attach(png, name="failure_screenshot", attachment_type=allure.attachment_type.PNG)
        allure.attach(drv.current_url, name="url_at_failure", attachment_type=allure.attachment_type.TEXT)
        log.error("FAILED %s -> screenshot saved", request.node.nodeid)

    drv.quit()


@pytest.fixture
def inventory_page(driver, config):
    """A browser already logged in and sitting on the inventory page."""
    timeout = config["timeout"]
    LoginPage(driver, timeout).open(config["base_url"]).login(config["username"], config["password"])
    page = InventoryPage(driver, timeout)
    assert page.title() == "Products", "Precondition failed: login did not reach inventory"
    return page
'''

