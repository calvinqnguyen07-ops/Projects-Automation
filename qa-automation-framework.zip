"""
ONE-SHOT SETUP: builds the whole QA automation framework project.

USAGE
    python setup_framework.py                    # creates ./qa-automation-framework
    python setup_framework.py my-project-name    # creates ./my-project-name

Then:
    cd qa-automation-framework
    python -m venv .venv && source .venv/bin/activate     # Windows: .venv\\Scripts\\activate
    pip install -r requirements.txt
    pytest
"""

