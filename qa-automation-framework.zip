FILES[".github/workflows/ui-tests.yml"] = r'''
name: UI Tests

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run tests (headless, 2 parallel workers)
        run: pytest --headless -n 2

      - name: Upload results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: |
            reports/allure-results
            screenshots
            logs
'''

# ==========================================================================
# README
# ==========================================================================
FILES["README.md"] = r'''
# QA Automation Framework

A Selenium + Pytest UI test framework using the Page Object Model, with data-driven tests,
Allure reporting, failure screenshots, logging, retries, parallel execution and CI.

**Application under test:** [SauceDemo](https://www.saucedemo.com), a public demo e-commerce site.

## Features

| Feature | How it's done |
|---|---|
| Page Object Model | `pages/` with a shared `BasePage` (explicit waits, logging) |
| Data-driven tests | CSV and JSON files in `test_data/`, fed to `pytest.mark.parametrize` |
| Multi-environment config | `config/environments.json`, chosen with `--env` |
| Cross-browser | Chrome, Firefox, Edge via `--browser` |
| Reporting | Allure (steps, failure screenshots, URL at failure) |
| Logging | Console + `logs/test_run.log` |
| Retries | `pytest-rerunfailures` (1 retry by default) |
| Parallel runs | `pytest-xdist` (`-n auto`) |
| Test tagging | `smoke` and `regression` markers |
| CI | GitHub Actions workflow, runs headless on every push and PR |
| Secrets | Password can be overridden with the `APP_PASSWORD` environment variable |

## Project structure

```
qa-automation-framework/
├── .github/workflows/ui-tests.yml   # CI pipeline
├── config/environments.json         # per-environment settings
├── pages/                           # page objects
│   ├── base_page.py
│   ├── login_page.py
│   ├── inventory_page.py
│   ├── cart_page.py
│   └── checkout_page.py
├── test_data/                       # CSV / JSON test data
├── tests/                           # test cases
├── utils/                           # logger, config loader, data reader, driver factory
├── conftest.py                      # CLI options, fixtures, failure screenshots
├── pytest.ini                       # markers and default options
└── requirements.txt
```

## Setup

```bash
python -m venv .venv
source .venv/bin/activate        # Windows: .venv\Scripts\activate
pip install -r requirements.txt
```

Selenium 4.6+ downloads the right browser driver automatically.

## Running tests

```bash
pytest                                  # everything, Chrome, visible browser
pytest --headless                       # no UI
pytest -m smoke                         # only smoke tests
pytest -m regression                    # only regression tests
pytest --browser firefox                # another browser
pytest --env staging                    # another environment
pytest -n auto --headless               # parallel
pytest -k checkout                      # tests matching a name
```

## Reports

Results are written to `reports/allure-results` on every run. To view the report you need the
[Allure command line tool](https://allurereport.org/docs/install/):

```bash
allure serve reports/allure-results
```

Failure screenshots are also saved to `screenshots/` and logs to `logs/test_run.log`.

## Adding a new test

1. Add a page object in `pages/` if the test needs a new page (extend `BasePage`).
2. Add the test in `tests/` and tag it with `@pytest.mark.smoke` or `@pytest.mark.regression`.
3. For data-driven cases, add rows to a file in `test_data/` and load them with `utils/data_reader.py`.

## Design decisions

- **Explicit waits only.** Implicit waits are disabled, because mixing the two causes unpredictable timeouts.
- **Fixtures own setup and teardown.** Tests never create or quit drivers themselves.
- **Test data lives outside the code**, so adding a case means adding a row, not writing a test.
- **Passwords are never logged.** `BasePage.type` logs the locator but not the text.
'''


def main():
    for relative_path, content in FILES.items():
        path = ROOT / relative_path
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content.lstrip("\n"), encoding="utf-8")
    print(f"Created {len(FILES)} files in ./{ROOT}")
    print(f"Next:  cd {ROOT}  &&  pip install -r requirements.txt  &&  pytest")


if __name__ == "__main__":
    main()
